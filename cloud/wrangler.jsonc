{
  "name": "springbok-node-protocol-test",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "limits": { "cpu_ms": 10 },
  "vars": { "ENABLE_PROTOCOL_TEST": "no", "ENABLE_FIXTURE_CYCLE": "no", "ENABLE_ADMIN": "no", "ENABLE_CATALOG": "no", "ENABLE_NODE_MAILBOX": "no", "ENABLE_NODE_ENROLLMENT": "no", "ENABLE_NODE_CREDENTIALS": "no", "ENABLE_NODE_CHANNEL": "no", "ENABLE_NODE_HEARTBEAT": "no", "ENABLE_NODE_TELEMETRY": "no", "ENABLE_SBA": "no", "ENABLE_CONNECTIONS": "no", "ENABLE_CONNECTED_DEPLOYMENTS": "no", "ADMIN_EMAILS": "[]" },
  "durable_objects": { "bindings": [{ "name": "TARGET", "class_name": "TargetMailbox" }, { "name": "REGISTRY", "class_name": "OwnerCatalog" }, { "name": "NODES", "class_name": "NodeMailbox" }, { "name": "TELEMETRY", "class_name": "NodeTelemetry" }, { "name": "SBA_TASKS", "class_name": "SbaDeployment" }, { "name": "CONNECTIONS", "class_name": "ConnectionVault" }, { "name": "CONNECTED_TASKS", "class_name": "ConnectedDeployment" }, { "name": "DEPLOYMENT_LOCKS", "class_name": "DeploymentLocks" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TargetMailbox"] }, { "tag": "v2-catalog", "new_sqlite_classes": ["OwnerCatalog"] }, { "tag": "v3-node-mailbox", "new_sqlite_classes": ["NodeMailbox"] }, { "tag": "v4-node-telemetry", "new_sqlite_classes": ["NodeTelemetry"] }, { "tag": "v5-sba-deployment", "new_sqlite_classes": ["SbaDeployment"] }, { "tag": "v6-connections", "new_sqlite_classes": ["ConnectionVault"] }, { "tag": "v7-connected-deployments", "new_sqlite_classes": ["ConnectedDeployment", "DeploymentLocks"] }],
  "assets": { "directory": "../public/cloud-admin", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false }
}

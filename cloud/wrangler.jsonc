{
  "name": "springbok-node-protocol-test",
  "main": "worker.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "limits": { "cpu_ms": 10 },
  "vars": { "ENABLE_PROTOCOL_TEST": "no", "ENABLE_FIXTURE_CYCLE": "no", "ENABLE_ADMIN": "no", "ENABLE_CATALOG": "no", "ENABLE_NODE_MAILBOX": "no", "ADMIN_EMAILS": "[]" },
  "durable_objects": { "bindings": [{ "name": "TARGET", "class_name": "TargetMailbox" }, { "name": "REGISTRY", "class_name": "OwnerCatalog" }, { "name": "NODES", "class_name": "NodeMailbox" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TargetMailbox"] }, { "tag": "v2-catalog", "new_sqlite_classes": ["OwnerCatalog"] }, { "tag": "v3-node-mailbox", "new_sqlite_classes": ["NodeMailbox"] }],
  "assets": { "directory": "../public/cloud-admin", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": false }
}
